# Vector/LLM API Configuration
# Base URL for the API (e.g., https://api.openai.com/v1, https://api.deepseek.com/v1, or your local endpoint)
API_BASE_URL=https://your-api-endpoint.com/v1

# Your API Key
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model Names
# The model used for embeddings (e.g., text-embedding-3-small, bge-m3)
EMBEDDING_MODEL=text-embedding-3-small

# The model used for generating questions (e.g., gpt-3.5-turbo, deepseek-chat)
LLM_MODEL=gpt-3.5-turbo

# Generation Settings
QUESTIONS_COUNT=20
